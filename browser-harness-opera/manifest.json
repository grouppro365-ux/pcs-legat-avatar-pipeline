{
  "manifest_version": 3,
  "name": "Agency Browser Harness",
  "version": "0.1.2",
  "description": "Stable Opera adaptation of scriby/browser-harness: original v0.1.1 ChatGPT transport with same-origin CMS iframe and text-edit fixes.",
  "permissions": ["tabs", "storage", "scripting", "debugger", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {"service_worker": "bootstrap.js"},
  "action": {
    "default_popup": "workbench.html",
    "default_title": "Agency Browser Harness"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["browser_harness_client.js"],
      "run_at": "document_idle"
    }
  ]
}
