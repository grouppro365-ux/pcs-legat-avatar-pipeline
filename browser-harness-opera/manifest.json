{
  "manifest_version": 3,
  "name": "Agency Browser Harness",
  "version": "0.3.1",
  "description": "Opera Browser Harness with durable event-driven ChatGPT planning, verified actions, batch checkpoints and embedded seo-article-writer-tatyana.",
  "permissions": ["tabs", "storage", "scripting", "debugger", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {"service_worker": "bootstrap.js"},
  "action": {
    "default_popup": "workbench.html",
    "default_title": "Agency Browser Harness"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["browser_harness_client.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["planner_protocol.js", "chatgpt_observer.js"],
      "run_at": "document_idle"
    }
  ]
}
