PORT=8787
BRIDGE_SECRET=change-me

# Postiz Cloud by default. Point to your self-hosted Postiz API if needed.
POSTIZ_API_URL=https://api.postiz.com
POSTIZ_API_KEY=

# OpenAI generation layer
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.1
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_VIDEO_MODEL=sora-2

# Optional defaults
DEFAULT_TIMEZONE=Asia/Bangkok
DEFAULT_PROJECT=legat-abc
