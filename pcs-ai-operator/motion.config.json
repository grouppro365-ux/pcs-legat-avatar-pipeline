{
  "version": "1.0.0",
  "reducedMotion": {
    "respectUserPreference": true,
    "fallbackDurationMs": 0
  },
  "tokens": {
    "duration": {
      "instant": 90,
      "fast": 140,
      "normal": 220,
      "slow": 360,
      "scene": 520
    },
    "easing": {
      "standard": "cubic-bezier(0.22, 1, 0.36, 1)",
      "soft": "cubic-bezier(0.16, 1, 0.3, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)",
      "springLike": "cubic-bezier(0.34, 1.56, 0.64, 1)"
    },
    "distance": {
      "xs": 4,
      "sm": 8,
      "md": 14,
      "lg": 22
    },
    "scale": {
      "pressed": 0.985,
      "enter": 0.975,
      "hover": 1.012
    }
  },
  "presets": {
    "pageEnter": {
      "from": {"opacity": 0, "translateY": 12},
      "to": {"opacity": 1, "translateY": 0},
      "duration": "scene",
      "easing": "soft"
    },
    "cardEnter": {
      "from": {"opacity": 0, "translateY": 10, "scale": 0.985},
      "to": {"opacity": 1, "translateY": 0, "scale": 1},
      "duration": "normal",
      "easing": "standard"
    },
    "sheetOpen": {
      "from": {"opacity": 0, "translateY": 24, "scale": 0.985},
      "to": {"opacity": 1, "translateY": 0, "scale": 1},
      "duration": "slow",
      "easing": "soft"
    },
    "sheetClose": {
      "from": {"opacity": 1, "translateY": 0, "scale": 1},
      "to": {"opacity": 0, "translateY": 18, "scale": 0.99},
      "duration": "fast",
      "easing": "exit"
    },
    "statusChange": {
      "from": {"opacity": 0.7, "scale": 0.98},
      "to": {"opacity": 1, "scale": 1},
      "duration": "normal",
      "easing": "springLike"
    },
    "buttonPress": {
      "from": {"scale": 1},
      "to": {"scale": 0.985},
      "duration": "instant",
      "easing": "standard"
    },
    "toastIn": {
      "from": {"opacity": 0, "translateY": 8, "scale": 0.98},
      "to": {"opacity": 1, "translateY": 0, "scale": 1},
      "duration": "fast",
      "easing": "soft"
    },
    "metricPulse": {
      "from": {"opacity": 0.65, "scale": 0.985},
      "to": {"opacity": 1, "scale": 1},
      "duration": "normal",
      "easing": "springLike"
    }
  },
  "scenes": {
    "inbox": {
      "page": "pageEnter",
      "metrics": {"preset": "cardEnter", "staggerMs": 45},
      "conversationList": {"preset": "cardEnter", "staggerMs": 28},
      "message": {"preset": "cardEnter", "staggerMs": 20}
    },
    "knowledge": {
      "page": "pageEnter",
      "list": {"preset": "cardEnter", "staggerMs": 24},
      "editor": "sheetOpen",
      "statusUpdate": "statusChange"
    },
    "connections": {
      "page": "pageEnter",
      "cards": {"preset": "cardEnter", "staggerMs": 36},
      "testResult": "statusChange"
    },
    "status": {
      "page": "pageEnter",
      "rows": {"preset": "cardEnter", "staggerMs": 32},
      "valueChange": "statusChange"
    },
    "approvals": {
      "page": "pageEnter",
      "cards": {"preset": "cardEnter", "staggerMs": 32},
      "decision": "statusChange"
    }
  }
}
