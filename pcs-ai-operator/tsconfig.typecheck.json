{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowJs": false,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@pcs/core": ["packages/core/src/index.ts"],
      "@pcs/backend": ["packages/backend/src/index.ts"]
    },
    "types": ["node"]
  },
  "include": ["packages/**/*.ts", "apps/api/**/*.ts", "apps/worker/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
